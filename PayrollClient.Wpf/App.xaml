<Application x:Class="PayrollClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PayrollClient.Converters"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:TermConverter x:Key="Term" />
            <conv:ColumnHeaderConverter x:Key="ColumnHeader" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:MoneyConverter x:Key="Money" />
            <conv:RateConverter x:Key="Rate" />
            <conv:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
