<Application x:Class="PayrollClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PayrollClient.Converters"
             ShutdownMode="OnLastWindowClose">
    <!--
        Словарь Themes/Theme.xaml подключается в App.OnStartup, а не здесь:
        ошибка в словаре стилей при статической загрузке завершает приложение
        ещё до первого окна и без сообщения пользователю.
        Конвертеры объявлены в коде (RegisterConverters) по той же причине.
    -->
</Application>
