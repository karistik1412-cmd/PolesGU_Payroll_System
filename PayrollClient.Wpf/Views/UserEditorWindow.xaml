<Window x:Class="PayrollClient.Views.UserEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый пользователь"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CardBg}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True">

    <Border Style="{StaticResource CardTight}" Margin="14" Padding="20,16">
        <StackPanel>
            <TextBlock x:Name="lblHeader" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />

            <TextBlock x:Name="lblLogin" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
            <TextBox x:Name="txtLogin" Style="{StaticResource AppTextBox}" Margin="0,0,0,12" />

            <TextBlock x:Name="lblPassword" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
            <PasswordBox x:Name="txtPassword" Height="32" Padding="8,0" FontSize="12"
                         BorderBrush="{StaticResource Border}" Background="White"
                         VerticalContentAlignment="Center" Margin="0,0,0,12" />

            <TextBlock x:Name="lblPassword2" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
            <PasswordBox x:Name="txtPassword2" Height="32" Padding="8,0" FontSize="12"
                         BorderBrush="{StaticResource Border}" Background="White"
                         VerticalContentAlignment="Center" Margin="0,0,0,12" />

            <TextBlock x:Name="lblRole" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
            <ComboBox x:Name="cmbRole" Style="{StaticResource AppComboBox}" Margin="0,0,0,18" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCancel" Style="{StaticResource GhostButton}"
                        Margin="0,0,8,0" Click="OnCancelClick" />
                <Button x:Name="btnSave" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
