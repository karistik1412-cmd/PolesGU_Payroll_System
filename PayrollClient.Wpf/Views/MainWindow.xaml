<Window x:Class="PayrollClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PayrollClient.Controls"
        Title="ПолесГУ — Система начисления заработной платы"
        Width="1400" Height="820" MinWidth="1180" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBg}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             БОКОВОЕ МЕНЮ
             ============================================================ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="92" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Шапка -->
                <Border Grid.Row="0" Background="{StaticResource SidebarHeaderBg}"
                        BorderBrush="{StaticResource SidebarDivider}" BorderThickness="0,0,0,1">
                    <StackPanel VerticalAlignment="Center" Margin="22,0,0,0">
                        <TextBlock x:Name="lblBrand" FontSize="23" FontWeight="Bold" Foreground="White" />
                        <TextBlock x:Name="lblBrandSub" FontSize="10"
                                   Foreground="{StaticResource SidebarTextMuted}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Пункты меню -->
                <StackPanel Grid.Row="2">
                    <RadioButton x:Name="navHome" Content="Главная" GroupName="SidebarNav" Style="{StaticResource SidebarItem}"
                                 Checked="OnNavHome" />
                    <RadioButton x:Name="navEmployees" Content="Сотрудники" GroupName="SidebarNav" Style="{StaticResource SidebarItem}"
                                 Checked="OnNavEmployees" />
                    <RadioButton x:Name="navTimesheet" Content="Табель" GroupName="SidebarNav" Style="{StaticResource SidebarItem}"
                                 Checked="OnNavTimesheet" />
                    <RadioButton x:Name="navPayroll" Content="Расчёт зарплаты" GroupName="SidebarNav" Style="{StaticResource SidebarItem}"
                                 Checked="OnNavPayroll" />
                    <RadioButton x:Name="navUsers" Content="Пользователи" GroupName="SidebarNav" Style="{StaticResource SidebarItem}"
                                 Checked="OnNavUsers" />
                </StackPanel>

                <!-- Профиль и выход -->
                <Border Grid.Row="3" Background="{StaticResource SidebarHeaderBg}"
                        BorderBrush="{StaticResource SidebarDivider}" BorderThickness="0,1,0,0">
                    <StackPanel Margin="22,12,0,10">
                        <TextBlock x:Name="lblRoleInfo" FontSize="10"
                                   Foreground="{StaticResource SidebarTextMuted}" />
                        <Button x:Name="btnLogout" Content="Выход из системы"
                                Style="{StaticResource GhostButton}"
                                Foreground="White" HorizontalAlignment="Left"
                                Padding="0" Margin="0,8,0,0" Click="OnLogoutClick" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================
             РАБОЧАЯ ОБЛАСТЬ
             ============================================================ -->
        <Grid Grid.Column="1" Background="{StaticResource PageBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="62" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <!-- Заголовок раздела -->
            <Border Grid.Row="0" Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <StackPanel VerticalAlignment="Center" Margin="24,0,24,0">
                    <TextBlock x:Name="lblPageTitle" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="lblPageSubtitle" Style="{StaticResource PageSubtitle}" Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <!-- Содержимое раздела -->
            <Grid Grid.Row="1" Margin="20,14,20,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ====================================================
                     ПАНЕЛЬ ИНСТРУМЕНТОВ (единый вид на всех экранах):
                     строка 1 — период и поиск, строка 2 — кнопки
                     ==================================================== -->
                <Border x:Name="toolbarCard" Grid.Row="0" Style="{StaticResource CardTight}"
                        Padding="16,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Строка 1: период + поиск -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel x:Name="periodPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="lblMonthCaption" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                                <ComboBox x:Name="cmbMonth" Style="{StaticResource AppComboBox}"
                                          Width="150" SelectionChanged="OnPeriodChanged" />

                                <TextBlock x:Name="lblYearCaption" Style="{StaticResource FieldLabel}"
                                           Margin="16,0,8,0" />
                                <ComboBox x:Name="cmbYear" Style="{StaticResource AppComboBox}"
                                          Width="100" SelectionChanged="OnPeriodChanged" />
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="lblSearch" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                                <TextBox x:Name="txtSearch" Style="{StaticResource AppTextBox}" Width="220"
                                         TextChanged="OnSearchChanged" />
                            </StackPanel>
                        </Grid>

                        <!-- Строка 2: кнопки действий текущего экрана -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="actionBar" Orientation="Horizontal" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Страница -->
                <Grid Grid.Row="1">
                    <Grid x:Name="pageHost" />
                </Grid>
            </Grid>

            <!-- Итоговая строка (под содержимым) -->
            <Border Grid.Row="2" Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                <Grid Margin="24,0,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PrimaryGreen}" Margin="0,10,0,10" />
                    <TextBlock x:Name="lblFooter" Grid.Column="1" Margin="12,0,0,0"
                               VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
